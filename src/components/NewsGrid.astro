---
import NewsCard from './NewsCard.astro';
const { items = [], cmsUrl } = Astro.props;
---
<section class="news-grid" aria-label="Daftar berita">
  {items.map((item) => <NewsCard item={item} cmsUrl={cmsUrl} />)}
</section>

<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 860px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>