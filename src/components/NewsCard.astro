---
const { item, cmsUrl } = Astro.props;
const categoryLabel = item.kateogori?.nama || item.kategori?.nama || '';

function formatDate(value) {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return date.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const coverUrl = item.cover ? `${cmsUrl}/assets/${encodeURIComponent(item.cover)}` : null;
---
<article class="news-card">
  <a class="card-link" href={`/baca?slug=${encodeURIComponent(item.slug ?? '')}`}>
    {coverUrl ? (
      <img
        class="cover"
        src={coverUrl}
        alt={item.judul ? `Gambar ${item.judul}` : 'Gambar berita'}
        loading="lazy"
      />
    ) : (
      <div class="cover placeholder">Kabar Baik</div>
    )}

    <div class="card-content">
      <time dateTime={item.date_created ?? ''}>{formatDate(item.date_created)}</time>
      <h2>{item.judul || 'Berita tanpa judul'}</h2>
      {categoryLabel ? <span class="category-label">{categoryLabel}</span> : null}
      <span class="read-more">Baca selengkapnya →</span>
    </div>
  </a>
</article>

<style>
  .news-card {
    min-width: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e0e6e1;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgb(20 53 34 / 7%);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgb(20 53 34 / 13%);
  }

  .card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #dfe9e2;
  }

  .placeholder {
    display: grid;
    place-items: center;
    color: #397451;
    font-weight: 800;
    background: linear-gradient(135deg, #dceee2, #eff6f1);
  }

  .card-content {
    padding: 22px;
  }

  .category-label {
    display: inline-flex;
    margin-top: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #eef7ef;
    color: #246438;
    font-size: 0.82rem;
    font-weight: 700;
  }

  time {
    color: #6b756e;
    font-size: 0.82rem;
  }

  h2 {
    margin: 9px 0 12px;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .read-more {
    display: inline-block;
    margin-top: 10px;
    color: #176b3a;
    font-size: 0.9rem;
    font-weight: 750;
  }
</style>