---
const {
  title = 'Kabar Baik - Portal Berita',
  description = 'Kabar Baik, portal berita yang menyajikan kabar terbaru untuk Anda.',
  activeSlug = '',
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <div class="brand-group">
          <a class="brand" href="/" aria-label="Kabar Baik, halaman utama">Kabar Baik</a>
          <p>Sumber berita terpercaya Anda</p>
        </div>
        <nav id="category-nav" class="site-nav" data-active-slug={activeSlug} aria-label="Kategori berita">
          <ul class="site-menu">
            <li><a href="/">Semua</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="container page-shell">
      <slot />
    </main>
    <footer>
      <div class="container footer-inner">&copy; {new Date().getFullYear()} Kabar Baik</div>
    </footer>

    <script type="module">
      const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';

      async function loadCategoryNav() {
        const nav = document.getElementById('category-nav');
        if (!nav) return;
        const list = nav.querySelector('.site-menu');
        const activeSlug = nav.dataset.activeSlug || '';

        try {
          const response = await fetch(
            `${cmsUrl}/items/kategori?fields=id,nama,slug,show_in_menu,sort&filter[show_in_menu][_eq]=true&sort=sort`
          );
          if (!response.ok) return;
          const result = await response.json();
          const categories = Array.isArray(result.data) ? result.data : [];

          categories.forEach((category) => {
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = `/kategori?slug=${encodeURIComponent(category.slug)}`;
            link.textContent = category.nama;
            if (category.slug === activeSlug) {
              link.classList.add('active');
            }
            item.appendChild(link);
            list.appendChild(item);
          });
        } catch (error) {
          console.error('Gagal memuat navigasi kategori:', error);
        }
      }

      loadCategoryNav();
    </script>
  </body>
</html>

<style>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    color: #17211b;
    background: #f6f8f5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: #f6f8f5;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    padding: 32px 0;
    color: #fff;
    background: #176b3a;
  }

  .header-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand-group {
    min-width: 260px;
  }

  .brand {
    color: inherit;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .brand-group p {
    margin: 6px 0 0;
    color: #d9f1e2;
  }

  .page-shell {
    min-height: calc(100vh - 240px);
    padding-block: 48px 64px;
  }

  footer {
    padding: 28px 0;
    color: #d9e7dd;
    background: #123c25;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .header-inner {
      align-items: flex-start;
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 28px, 1120px);
    }

    .site-header {
      padding: 24px 0;
    }

    .page-shell {
      padding-block: 36px 48px;
    }
  }
</style>