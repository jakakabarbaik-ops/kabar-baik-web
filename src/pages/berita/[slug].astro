---
export async function getStaticPaths() {
  import { directus } from '../../lib/directus';
  import { readItems } from '@directus/sdk';
  
  try {
    const semuaBerita = await directus.request(
      readItems('berita', { fields: ['slug'] })
    );
    return semuaBerita.map((berita) => ({
      params: { slug: berita.slug },
    }));
  } catch (e) {
    return [];
  }
}

const { slug } = Astro.params;
const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';
