---
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';

export async function getStaticPaths() {
  const semuaBerita = await directus.request(
    readItems('berita', {
      fields: ['slug', 'judul', 'konten', 'date_created', 'cover'],
    })
  );

  return semuaBerita.map((berita) => {
    return {
      params: { slug: berita.slug },
      props: { berita }
    };
  });
}

const { berita } = Astro.props;
const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL;

const tanggal = new Date(berita.date_created).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{berita.judul} - Kabar Baik</title>
  </head>
  <body style="font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; background-color: #fff; color: #333;">
    
    <a href="/" style="display: inline-block; margin-bottom: 20px; color: #2563eb; text-decoration: none;">
      &larr; Kembali ke Beranda
    </a>

    <h1 style="font-size: 32px; font-weight: bold; margin-bottom: 10px; color: #111827;">
      {berita.judul}
    </h1>
    <p style="color: #6b7280; margin-bottom: 20px;">Tayang: {tanggal}</p>

    {/* Format penulisan gambar ini lebih aman dari error */}
    {berita.cover && <img src={`${cmsUrl}/assets/${berita.cover}`} alt={berita.judul} style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 30px;" />}

    <div style="font-size: 18px; line-height: 1.8;" set:html={berita.konten} />

  </body>
</html>