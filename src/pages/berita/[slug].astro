---
import { directus } from '../../lib/directus';
import { readItems } from '@directus/sdk';

export async function getStaticPaths() {
  const semuaBerita = await directus.request(
    readItems('berita', { fields: ['slug', 'judul', 'konten', 'date_created', 'cover'] })
  );

  return semuaBerita.map((berita) => {
    return { params: { slug: berita.slug }, props: { berita } };
  });
}

const { berita } = Astro.props;
const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';

const tanggal = new Date(berita.date_created).toLocaleDateString('id-ID', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---


  
    
    
