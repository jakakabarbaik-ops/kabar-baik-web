---
import SiteLayout from '../layouts/SiteLayout.astro';

const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';
---

<SiteLayout categories={[]}>
  <article class="article-page">
    <a class="back-link" href="/">← Kembali ke Beranda</a>
    <div id="loading" class="loading">Memuat artikel...</div>
    <div id="article-container" class="article-container" hidden>
      <h1 id="judul"></h1>
      <p class="article-meta" id="tanggal"></p>
      <img id="cover" class="article-cover" src="" alt="" hidden />
      <div id="konten" class="article-body"></div>
    </div>
  </article>
</SiteLayout>

<script define:vars={{ cmsUrl }}>
  const loading = document.getElementById('loading');
  const articleContainer = document.getElementById('article-container');
  const titleEl = document.getElementById('judul');
  const dateEl = document.getElementById('tanggal');
  const coverEl = document.getElementById('cover');
  const contentEl = document.getElementById('konten');

  async function loadArticle() {
    const urlParams = new URLSearchParams(window.location.search);
    const slug = urlParams.get('slug');

    if (!slug) {
      loading.textContent = 'Artikel tidak ditemukan.';
      return;
    }

    try {
      const endpoint = new URL(`${cmsUrl}/items/berita`);
      endpoint.searchParams.set('fields', 'id,judul,konten,cover,date_created,slug');
      endpoint.searchParams.set('filter[slug][_eq]', slug);
      endpoint.searchParams.set('limit', '1');

      const response = await fetch(endpoint);
      if (!response.ok) {
        const errorText = await response.text();
        throw new Error(`Gagal memuat artikel: ${response.status} ${errorText}`);
      }

      const result = await response.json();
      const berita = Array.isArray(result.data) ? result.data[0] : null;

      if (!berita) {
        loading.textContent = 'Artikel tidak ditemukan.';
        return;
      }

      titleEl.textContent = berita.judul;
      dateEl.textContent = new Date(berita.date_created).toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });

      if (berita.cover) {
        coverEl.src = `${cmsUrl}/assets/${encodeURIComponent(berita.cover)}`;
        coverEl.alt = berita.judul ? `Gambar ${berita.judul}` : 'Gambar berita';
        coverEl.hidden = false;
      }

      contentEl.innerHTML = berita.konten || '';
      loading.hidden = true;
      articleContainer.hidden = false;
    } catch (error) {
      console.error('Gagal memuat artikel:', error);
      loading.textContent = 'Gagal memuat artikel. Silakan coba beberapa saat lagi.';
    }
  }

  loadArticle();
</script>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 24px;
    color: #176b3a;
    text-decoration: none;
    font-weight: 700;
  }

  .article-page h1 {
    margin-top: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  .article-meta {
    color: #6b756e;
    margin: 12px 0 24px;
  }

  .article-cover {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: 18px;
    margin-bottom: 32px;
  }

  .article-body {
    color: #323d33;
    line-height: 1.8;
  }

  .loading {
    padding: 32px;
    color: #58635c;
    text-align: center;
    background: #fff;
    border: 1px solid #e0e6e1;
    border-radius: 14px;
  }
</style>
