---
import SiteLayout from '../../layouts/SiteLayout.astro';
import NewsGrid from '../../components/NewsGrid.astro';

const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';

export async function getStaticPaths() {
  const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';
  const categoriesResponse = await fetch(
    `${cmsUrl}/items/kategori?fields=slug&filter[show_in_menu][_eq]=true&sort=sort`
  );
  const categoriesData = await categoriesResponse.json();
  const categories = Array.isArray(categoriesData.data) ? categoriesData.data : [];

  return categories.map((category) => ({ params: { slug: category.slug } }));
}

const slug = Astro.params.slug;
const categoriesResponse = await fetch(
  `${cmsUrl}/items/kategori?fields=id,nama,slug,show_in_menu,sort&filter[show_in_menu][_eq]=true&sort=sort`
);
const categoriesData = await categoriesResponse.json();
const categories = Array.isArray(categoriesData.data) ? categoriesData.data : [];

const categoryResponse = await fetch(
  `${cmsUrl}/items/kategori?fields=id,nama,slug&filter[slug][_eq]=${encodeURIComponent(slug)}&limit=1`
);
const categoryData = await categoryResponse.json();
const category = Array.isArray(categoryData.data) ? categoryData.data[0] : null;

const newsResponse = await fetch(
  `${cmsUrl}/items/berita?fields=id,judul,slug,cover,date_created,kateogori.*&filter[kateogori][slug][_eq]=${encodeURIComponent(slug)}&sort=-date_created`
);
const newsData = await newsResponse.json();
const newsItems = Array.isArray(newsData.data) ? newsData.data : [];
---

<SiteLayout categories={categories} activeSlug={slug}>
  <div class="section-heading">
    <div>
      <span class="eyebrow">Kategori</span>
      <h1>{category?.nama ?? 'Kategori tidak ditemukan'}</h1>
    </div>
  </div>

  {category ? (
    newsItems.length === 0 ? (
      <p class="status" role="status">Belum ada berita untuk kategori ini.</p>
    ) : (
      <NewsGrid items={newsItems} cmsUrl={cmsUrl} />
    )
  ) : (
    <p class="status" role="status">Kategori tidak ditemukan.</p>
  )}
</SiteLayout>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .eyebrow {
    color: #26794a;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 5px 0 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.04em;
  }

  .status {
    padding: 24px;
    color: #58635c;
    text-align: center;
    background: #fff;
    border: 1px solid #e0e6e1;
    border-radius: 14px;
  }
</style>
