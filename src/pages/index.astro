---
import SiteLayout from '../layouts/SiteLayout.astro';
import NewsGrid from '../components/NewsGrid.astro';
---

<SiteLayout categories={[]}> 
  <div class="section-heading">
    <div>
      <span class="eyebrow">Pilihan terbaru</span>
      <h1>Berita Terkini</h1>
    </div>
  </div>

  <div id="status" class="status" role="status">Memuat berita terbaru...</div>
  <div id="news-list"></div>
</SiteLayout>

<script>
  const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';
  const statusEl = document.getElementById('status');
  const newsList = document.getElementById('news-list');

  function formatDate(value) {
    if (!value) return '';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleDateString('id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }

  function createNewsCard(news) {
    const article = document.createElement('article');
    article.className = 'news-card';

    const link = document.createElement('a');
    link.className = 'card-link';
    link.href = `/baca?slug=${encodeURIComponent(news.slug ?? '')}`;

    if (news.cover) {
      const image = document.createElement('img');
      image.className = 'cover';
      image.src = `${cmsUrl}/assets/${encodeURIComponent(news.cover)}`;
      image.alt = news.judul ? `Gambar ${news.judul}` : 'Gambar berita';
      image.loading = 'lazy';
      link.append(image);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'cover placeholder';
      placeholder.textContent = 'Kabar Baik';
      link.append(placeholder);
    }

    const content = document.createElement('div');
    content.className = 'card-content';

    const date = document.createElement('time');
    date.dateTime = news.date_created ?? '';
    date.textContent = formatDate(news.date_created);

    const title = document.createElement('h2');
    title.textContent = news.judul || 'Berita tanpa judul';

    content.append(date, title);

    const readMore = document.createElement('span');
    readMore.className = 'read-more';
    readMore.textContent = 'Baca selengkapnya →';
    content.append(readMore);

    link.append(content);
    article.append(link);
    return article;
  }

  async function loadNews() {
    try {
      const response = await fetch(
        `${cmsUrl}/items/berita?fields=id,judul,slug,cover,date_created&sort=-date_created&limit=12`
      );
      if (!response.ok) {
        throw new Error(`Directus merespons dengan status ${response.status}`);
      }
      const result = await response.json();
      const newsItems = Array.isArray(result.data) ? result.data : [];

      if (newsItems.length === 0) {
        statusEl.textContent = 'Belum ada berita yang diterbitkan.';
        return;
      }

      const fragment = document.createDocumentFragment();
      newsItems.forEach((news) => fragment.append(createNewsCard(news)));
      newsList.append(fragment);
      statusEl.hidden = true;
    } catch (error) {
      console.error('Gagal memuat berita:', error);
      statusEl.classList.add('error');
      statusEl.textContent = 'Berita belum dapat dimuat. Silakan coba beberapa saat lagi.';
    }
  }

  loadNews();
</script>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .eyebrow {
    color: #26794a;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 5px 0 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.04em;
  }

  .status {
    padding: 24px;
    color: #58635c;
    text-align: center;
    background: #fff;
    border: 1px solid #e0e6e1;
    border-radius: 14px;
  }

  .status.error {
    color: #9d2d24;
    background: #fff4f2;
    border-color: #f4cbc6;
  }
</style>
