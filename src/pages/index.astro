---
const cmsUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://cms.kabar-baik.id';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Kabar Baik, portal berita yang menyajikan kabar terbaru untuk Anda."
    />
    <title>Kabar Baik - Portal Berita</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label="Kabar Baik, halaman utama">Kabar Baik</a>
        <p>Sumber berita terpercaya Anda</p>
      </div>
    </header>

    <main class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Pilihan terbaru</span>
          <h1>Berita Terkini</h1>
        </div>
      </div>

      <p id="status" class="status" role="status">Memuat berita terbaru...</p>
      <section id="news-list" class="news-grid" aria-label="Daftar berita"></section>
    </main>

    <footer>
      <div class="container">&copy; {new Date().getFullYear()} Kabar Baik</div>
    </footer>

    <script define:vars={{ cmsUrl }}>
      const status = document.querySelector('#status');
      const newsList = document.querySelector('#news-list');

      function formatDate(value) {
        if (!value) return '';

        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '';

        return date.toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
      }

      function createNewsCard(news) {
        const article = document.createElement('article');
        article.className = 'news-card';

        const link = document.createElement('a');
        link.className = 'card-link';
        link.href = `/baca?slug=${encodeURIComponent(news.slug ?? '')}`;

        if (news.cover) {
          const image = document.createElement('img');
          image.className = 'cover';
          image.src = `${cmsUrl}/assets/${encodeURIComponent(news.cover)}`;
          image.alt = news.judul ? `Gambar ${news.judul}` : 'Gambar berita';
          image.loading = 'lazy';
          link.append(image);
        } else {
          const placeholder = document.createElement('div');
          placeholder.className = 'cover placeholder';
          placeholder.textContent = 'Kabar Baik';
          link.append(placeholder);
        }

        const content = document.createElement('div');
        content.className = 'card-content';

        const date = document.createElement('time');
        date.dateTime = news.date_created ?? '';
        date.textContent = formatDate(news.date_created);

        const title = document.createElement('h2');
        title.textContent = news.judul || 'Berita tanpa judul';

        content.append(date, title);

        const readMore = document.createElement('span');
        readMore.className = 'read-more';
        readMore.textContent = 'Baca selengkapnya →';
        content.append(readMore);

        link.append(content);
        article.append(link);
        return article;
      }

      async function loadNews() {
        try {
          const endpoint = new URL('/api/berita', window.location.origin);
          endpoint.searchParams.set(
            'fields',
            'judul,slug,cover,date_created'
          );
          endpoint.searchParams.set('sort', '-date_created');

          const response = await fetch(endpoint);
          if (!response.ok) {
            throw new Error(`Directus merespons dengan status ${response.status}`);
          }

          const result = await response.json();
          const newsItems = Array.isArray(result.data) ? result.data : [];

          if (newsItems.length === 0) {
            status.textContent = 'Belum ada berita yang diterbitkan.';
            return;
          }

          const fragment = document.createDocumentFragment();
          newsItems.forEach((news) => fragment.append(createNewsCard(news)));
          newsList.append(fragment);
          status.hidden = true;
        } catch (error) {
          console.error('Gagal memuat berita:', error);
          status.classList.add('error');
          status.textContent =
            'Berita belum dapat dimuat. Silakan coba beberapa saat lagi.';
        }
      }

      loadNews();
    </script>
  </body>
</html>

<style>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    color: #17211b;
    background: #f6f8f5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    padding: 32px 0;
    color: #fff;
    background: #176b3a;
  }

  .brand {
    color: inherit;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .site-header p {
    margin: 6px 0 0;
    color: #d9f1e2;
  }

  main {
    min-height: calc(100vh - 240px);
    padding-block: 48px 64px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .eyebrow {
    color: #26794a;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 5px 0 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.04em;
  }

  .status {
    padding: 24px;
    color: #58635c;
    text-align: center;
    background: #fff;
    border: 1px solid #e0e6e1;
    border-radius: 14px;
  }

  .status.error {
    color: #9d2d24;
    background: #fff4f2;
    border-color: #f4cbc6;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .news-card {
    min-width: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e0e6e1;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgb(20 53 34 / 7%);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgb(20 53 34 / 13%);
  }

  .card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #dfe9e2;
  }

  .placeholder {
    display: grid;
    place-items: center;
    color: #397451;
    font-weight: 800;
    background: linear-gradient(135deg, #dceee2, #eff6f1);
  }

  .card-content {
    padding: 22px;
  }

  time {
    color: #6b756e;
    font-size: 0.82rem;
  }

  h2 {
    margin: 9px 0 12px;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .card-content p {
    display: -webkit-box;
    margin: 0 0 18px;
    overflow: hidden;
    color: #5b665f;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .read-more {
    color: #176b3a;
    font-size: 0.9rem;
    font-weight: 750;
  }

  footer {
    padding: 28px 0;
    color: #d9e7dd;
    background: #123c25;
  }

  @media (max-width: 860px) {
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 28px, 1120px);
    }

    .site-header {
      padding: 24px 0;
    }

    main {
      padding-block: 36px 48px;
    }

    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
