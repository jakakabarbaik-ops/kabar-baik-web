---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
  <section class="page-intro">
    <div><span class="eyebrow">Kabar hari ini</span><h1>Berita Terkini</h1></div>
    <p>Informasi pilihan dan cerita terbaru yang layak Anda baca.</p>
  </section>

  <div id="status" class="status" role="status">Memuat berita terbaru...</div>
  <div id="news-root" hidden></div>
</SiteLayout>

<script>
  const CMS_URL = 'https://cms.kabar-baik.id';
  const statusEl = document.getElementById('status');
  const newsRoot = document.getElementById('news-root');

  const formatDate = (value) => value ? new Date(value).toLocaleDateString('id-ID', {
    day: 'numeric', month: 'long', year: 'numeric'
  }) : '';
  const articleUrl = (slug) => `/baca?slug=${encodeURIComponent(slug ?? '')}`;
  const coverUrl = (cover) => `${CMS_URL}/assets/${encodeURIComponent(cover)}`;

  function imageMarkup(news, className = '') {
    return news.cover
      ? `<img class="${className}" src="${coverUrl(news.cover)}" alt="Gambar ${news.judul || 'berita'}" loading="lazy" />`
      : '<div class="placeholder">Kabar Baik</div>';
  }

  function renderNews(items) {
    const [headline, ...otherNews] = items;
    const featuredNews = otherNews.slice(0, 4);
    const latestNews = otherNews.slice(4);

    newsRoot.innerHTML = `
      <section class="lead-layout">
        <article class="headline-card">
          <a href="${articleUrl(headline.slug)}">
            <div class="headline-media">
              ${imageMarkup(headline)}
              <span class="headline-label">Utama</span>
            </div>
            <div class="headline-content">
              <time datetime="${headline.date_created || ''}">${formatDate(headline.date_created)}</time>
              <h2>${headline.judul || 'Berita tanpa judul'}</h2>
              <span class="read-more">Baca berita →</span>
            </div>
          </a>
        </article>
        <div class="featured-list">
          <div class="list-heading"><h2>Pilihan Editor</h2><span>${featuredNews.length} berita</span></div>
          ${featuredNews.map((news, index) => `
            <article class="featured-item">
              <span class="item-number">${String(index + 1).padStart(2, '0')}</span>
              <a href="${articleUrl(news.slug)}">
                <time datetime="${news.date_created || ''}">${formatDate(news.date_created)}</time>
                <h3>${news.judul || 'Berita tanpa judul'}</h3>
              </a>
              ${news.cover ? `<img src="${coverUrl(news.cover)}" alt="" loading="lazy" />` : ''}
            </article>`).join('')}
        </div>
      </section>
      ${latestNews.length ? `
        <section class="latest-section">
          <div class="section-heading"><div><span class="eyebrow">Terbaru</span><h2>Kabar Lainnya</h2></div><span class="heading-line"></span></div>
          <div class="news-grid">
            ${latestNews.map((news) => `
              <article class="news-card"><a href="${articleUrl(news.slug)}">
                <div class="card-media">${imageMarkup(news)}</div>
                <div class="card-content">
                  <time datetime="${news.date_created || ''}">${formatDate(news.date_created)}</time>
                  <h3>${news.judul || 'Berita tanpa judul'}</h3>
                  <span class="read-more">Selengkapnya →</span>
                </div>
              </a></article>`).join('')}
          </div>
        </section>` : ''}
    `;

    statusEl.hidden = true;
    newsRoot.hidden = false;
  }

  async function loadNews() {
    try {
      const response = await fetch('/api/berita?fields=id,judul,slug,cover,date_created&sort=-date_created&limit=12', {
        headers: { Accept: 'application/json' }
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const result = await response.json();
      const items = Array.isArray(result.data) ? result.data : [];
      if (!items.length) {
        statusEl.textContent = 'Belum ada berita yang diterbitkan.';
        return;
      }
      renderNews(items);
    } catch (error) {
      console.error('Gagal memuat berita:', error);
      statusEl.classList.add('error');
      statusEl.textContent = 'Berita belum dapat dimuat. Silakan coba beberapa saat lagi.';
    }
  }

  loadNews();
</script>

<style>
  .page-intro { display:flex; align-items:end; justify-content:space-between; gap:32px; padding-bottom:24px; margin-bottom:32px; border-bottom:1px solid #dce4de; }
  .page-intro h1 { margin:5px 0 0; color:#13251a; font-size:clamp(2.25rem,5vw,3.8rem); line-height:.98; letter-spacing:-.055em; }
  .page-intro p { max-width:390px; margin:0; color:#647068; line-height:1.65; }
  .eyebrow { color:#26794a; font-size:.78rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .status { padding:24px; color:#58635c; text-align:center; background:#fff; border:1px solid #e0e6e1; border-radius:14px; }
  .status.error { color:#9d2d24; background:#fff4f2; border-color:#f4cbc6; }
  .lead-layout { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(310px,.85fr); gap:36px; }
  .headline-card, .news-card { overflow:hidden; background:#fff; border:1px solid #dce4de; border-radius:20px; box-shadow:0 16px 50px rgba(18,60,37,.08); }
  .headline-card a, .news-card a, .featured-item a { color:inherit; text-decoration:none; }
  .headline-media { position:relative; aspect-ratio:16/9; overflow:hidden; background:#dfeae2; }
  .headline-media img, .card-media img { width:100%; height:100%; object-fit:cover; transition:transform .35s ease; }
  .headline-card:hover img, .news-card:hover img { transform:scale(1.035); }
  .headline-label { position:absolute; left:18px; bottom:18px; padding:7px 12px; color:#fff; background:#177447; border-radius:999px; font-size:.7rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .headline-content { padding:26px 28px 30px; }
  time { color:#78837b; font-size:.78rem; font-weight:600; }
  .headline-content h2 { margin:9px 0 20px; font-size:clamp(1.7rem,3vw,2.65rem); line-height:1.08; letter-spacing:-.04em; }
  .read-more { color:#177447; font-size:.86rem; font-weight:800; }
  .list-heading, .section-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .list-heading { padding-bottom:16px; border-bottom:3px solid #176b3a; }
  .list-heading h2 { margin:0; font-size:1.25rem; }
  .list-heading span { color:#78837b; font-size:.75rem; }
  .featured-item { display:grid; grid-template-columns:34px minmax(0,1fr) 82px; align-items:center; gap:13px; padding:18px 0; border-bottom:1px solid #dce4de; }
  .item-number { align-self:start; color:#aab5ad; font-size:.75rem; font-weight:800; }
  .featured-item h3 { margin:5px 0 0; font-size:1rem; line-height:1.32; }
  .featured-item img { width:82px; height:68px; object-fit:cover; border-radius:9px; }
  .featured-item a:hover h3, .news-card a:hover h3 { color:#177447; }
  .latest-section { margin-top:64px; }
  .section-heading { margin-bottom:24px; }
  .section-heading h2 { margin:5px 0 0; font-size:clamp(1.8rem,3vw,2.5rem); letter-spacing:-.04em; }
  .heading-line { flex:1; height:1px; background:#d4ded7; }
  .news-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
  .news-card { border-radius:16px; box-shadow:none; transition:transform .2s ease,box-shadow .2s ease; }
  .news-card:hover { transform:translateY(-4px); box-shadow:0 14px 34px rgba(18,60,37,.09); }
  .card-media { aspect-ratio:16/10; overflow:hidden; background:#dfeae2; }
  .placeholder { display:grid; width:100%; height:100%; place-items:center; color:#176b3a; background:linear-gradient(145deg,#e9f2ec,#d7e7dc); font-weight:800; }
  .card-content { padding:18px 19px 20px; }
  .card-content h3 { min-height:2.7em; margin:7px 0 17px; font-size:1.08rem; line-height:1.35; }
  @media (max-width:900px) { .lead-layout { grid-template-columns:1fr; } .featured-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:24px; } .list-heading { grid-column:1/-1; } .news-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:620px) {
    .page-intro { display:block; }
    .page-intro p { margin-top:14px; }
    .featured-list, .news-grid { grid-template-columns:1fr; }
    .headline-media { aspect-ratio:16/8.5; max-height:190px; }
    .card-media { aspect-ratio:16/8.5; max-height:170px; }
    .headline-content { padding:20px; }
    .latest-section { margin-top:48px; }
  }
</style>
